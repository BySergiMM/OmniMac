#!/bin/sh
# Se ejecuta como root al final de la instalación (la contraseña ya la ha pedido
# el propio Instalador, solo para copiar la app en /Applications).
#
# NO instala ninguna regla de administrador. El modo «tapa cerrada» viene apagado y,
# si el usuario lo activa, es la propia app quien le enseña qué permite la regla de
# sudoers, le pide permiso y solo entonces la instala (con la contraseña de macOS).
# Instalarla aquí la dejaría puesta en todos los Mac, también en los de quien nunca
# usa ese modo, y daría a cualquier proceso del usuario poder sobre un ajuste de
# energía del sistema sin que nadie lo haya decidido.
TARGET="${2:-/Applications}"

# Por si quedó activo de una sesión anterior: valor normal.
/usr/bin/pmset -a disablesleep 0 >/dev/null 2>&1 || true

# Abre la app como el usuario en sesión (no como root).
CONSOLE_USER=$(stat -f %Su /dev/console 2>/dev/null || true)
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ] \
   && printf '%s' "$CONSOLE_USER" | grep -Eq '^[A-Za-z0-9._-]+$'; then
  sudo -u "$CONSOLE_USER" /usr/bin/open "$TARGET/OmniMac.app" >/dev/null 2>&1 || true
fi
exit 0
