<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>OmniMac</title>
    <organization>com.seergiii</organization>
    <domains enable_localSystem="true"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true"/>
    <welcome file="welcome.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.txt" mime-type="text/plain"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.seergiii.omnimac.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.seergiii.omnimac.pkg" visible="false">
        <pkg-ref id="com.seergiii.omnimac.pkg"/>
    </choice>
    <pkg-ref id="com.seergiii.omnimac.pkg" version="@VERSION@" onConclusion="none">OmniMac-component.pkg</pkg-ref>
</installer-gui-script>
